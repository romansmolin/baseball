// Credits domain: a double-entry ledger. The User table has NO balance field —
// the user's balance is the `balanceAfter` of their most recent transaction.
// `amount` is signed (positive=credit, negative=debit). `referenceType` +
// `referenceId` form a polymorphic pointer to whatever caused the transaction
// (ContestEntry, ContestPayout, AIUsageLog, an external payment provider, etc.).
// No cascade from User — financial data must survive account soft-delete.

enum CreditTransactionType {
  PURCHASE
  REFUND
  CONTEST_ENTRY_FEE
  CONTEST_WINNINGS
  AI_USAGE
  ADMIN_GRANT
  ADMIN_DEDUCT
}

enum CreditTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model CreditTransaction {
  id     String @id @default(cuid())
  // No cascade — financial data survives soft-delete
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Signed: positive credits the user, negative debits them
  amount       Int
  // Denormalized running total after this transaction is applied
  balanceAfter Int

  type   CreditTransactionType
  status CreditTransactionStatus

  // Polymorphic reference to the cause of the transaction
  referenceType String?
  referenceId   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}
