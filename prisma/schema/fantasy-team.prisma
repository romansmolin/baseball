// Fantasy team domain: a user's saved team — a draft they keep for use on an
// outside fantasy platform. Real-world players are referenced by
// externalPlayerId — we never store a Player model. RosterSlot keeps the
// player's name, position and team as saved, so a team renders without
// re-querying the data provider.

enum PlayerPosition {
  P
  C
  FIRST_BASE
  SECOND_BASE
  THIRD_BASE
  SS
  LF
  CF
  RF
  DH
  OF
  IF
  UTIL
}

enum RosterSlotPosition {
  P
  C
  FIRST_BASE
  SECOND_BASE
  THIRD_BASE
  SS
  OF
  UTIL
  BENCH
}

enum FantasyPlatform {
  YAHOO
  ESPN
  OTHER
}

enum ScoringPreset {
  POINTS
  CATEGORIES_5X5
}

enum FantasyFormat {
  H2H_POINTS
  H2H_CATEGORIES
  ROTO
  DFS
}

enum ForecastPeriod {
  DAY
  WEEK
  SEASON
}

enum LineupChanges {
  DAILY
  WEEKLY
}

model FantasyTeam {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Display fields surfaced by the team-builder UI
  name                    String
  leagueSlug              String
  platform                FantasyPlatform @default(OTHER)
  // Deprecated: superseded by `format`; no longer read or written.
  scoringPreset           ScoringPreset   @default(POINTS)
  format                  FantasyFormat   @default(H2H_POINTS)
  forecastPeriod          ForecastPeriod  @default(WEEK)
  lineupChanges           LineupChanges   @default(DAILY)
  // `{}` / `[]` mean "use the defaults" (scoring preset / 9-slot lineup).
  scoringRules            Json            @default("{}")
  slotConfig              Json            @default("[]")
  // null = no salary cap (Points formats have none).
  salaryCap               Int?
  captainExternalPlayerId Int?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rosterSlots RosterSlot[]

  @@index([userId])
  @@index([leagueSlug])
}

model RosterSlot {
  id            String      @id @default(cuid())
  fantasyTeamId String
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)

  externalPlayerId Int

  playerName     String
  playerPosition PlayerPosition
  playerTeamName String
  playerPhotoUrl String?

  slotPosition      RosterSlotPosition
  // Which slot of that type (0-based): a lineup can hold several OF or BENCH.
  slotIndex         Int                @default(0)
  // frozen at save time; null when the format has no salaries
  salaryAtLock      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fantasyTeamId])
  @@index([externalPlayerId])
}
